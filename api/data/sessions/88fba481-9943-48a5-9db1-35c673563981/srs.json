  "sections": {
    "introduction": {
      "purpose": "This document defines the functional and non-functional requirements for Untitled App.",
      "product_scope": {
        "summary": "A school management app for teachers to assign tasks, parents to receive alerts, and administrators to export IEEE SRS documents.",
        "business_objectives": [
          "Clarify scope early",
          "Create a delivery-ready requirements baseline"
        ],
        "benefits": [
          "Reduces ambiguity",
          "Improves downstream handoff",
          "Transforms guided interview answers into a structured IEEE SRS"
        ],
        "goals": [
          "Deliver the first usable release of Untitled App.",
          "Support JSON and PDF artifact export"
        ]
      }
    },
    "overall_description": {
      "product_perspective": {
        "system_context": "Untitled App is delivered through web browser with an API layer, AI orchestration, persistent storage, and downloadable artifacts.",
        "product_origin": "New system",
