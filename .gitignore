*.rar

# Kept out of this repository deliberately:
#   .claude        editor/agent configuration, specific to one machine
#   tests/         not shipped with the application
#   locode.iconset  desktop-icon source, and the desktop shell is gone
.claude/
tests/
test_*.py
locode.iconset/
#   backups/      deployment records from a working machine, not the app
backups/
