{
  "auth-service": {
    "port": 3001,
    "entities": [
      "User"
    ],
    "controllers": [
      "authController",
      "userController"
    ],
    "routes": [
      {
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      {
        "method": "GET",
        "path": "/api/v1/users/me"
      }
    ],
    "packageDependencies": [
      "express",
      "mongoose",
      "cors",
      "dotenv",
      "helmet",
      "express-rate-limit",
      "body-parser",
      "jsonwebtoken",
      "bcryptjs",
      "axios",
      "swagger-jsdoc",
      "swagger-ui-express"
    ],
    "devDependencies": [
      "nodemon"
    ],
    "serviceDependencies": [],
    "envVars": [
      "PORT",
      "MONGO_URL",
      "SEKRET_KEY",
      "SERVER_URL"
    ],
    "requiredFiles": [
      "package.json",
      "Server.js",
      "DbConnection.js",
      ".env.example",
      "controllers/authController.js",
      "models/user.model.js",
      "services/user.service.js",
      "controllers/auth.controller.js",
      "routes/auth.routes.js",
      "controllers/users.controller.js",
      "routes/users.routes.js"
    ]
  },
  "task-service": {
    "port": 3002,
    "entities": [
      "Task"
    ],
    "controllers": [
      "taskController"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/api/v1/tasks"
      }
    ],
    "packageDependencies": [
      "express",
      "mongoose",
      "cors",
      "dotenv",
      "helmet",
      "express-rate-limit",
      "body-parser",
      "jsonwebtoken",
      "bcryptjs",
      "axios",
      "swagger-jsdoc",
      "swagger-ui-express"
    ],
    "devDependencies": [
      "nodemon"
    ],
    "serviceDependencies": [
      "auth-service"
    ],
    "envVars": [
      "PORT",
      "MONGO_URL",
      "SEKRET_KEY",
      "SERVER_URL",
      "AUTH_SERVICE_URL"
    ],
    "requiredFiles": [
      "package.json",
      "Server.js",
      "DbConnection.js",
      ".env.example",
      "controllers/authController.js",
      "models/task.model.js",
      "services/task.service.js",
      "controllers/tasks.controller.js",
      "routes/tasks.routes.js"
    ]
  },
  "dashboard-service": {
    "port": 3003,
    "entities": [
      "Dashboard"
    ],
    "controllers": [
      "dashboardController"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/api/v1/dashboard"
      }
    ],
    "packageDependencies": [
      "express",
      "mongoose",
      "cors",
      "dotenv",
      "helmet",
      "express-rate-limit",
      "body-parser",
      "jsonwebtoken",
      "bcryptjs",
      "axios",
      "swagger-jsdoc",
      "swagger-ui-express"
    ],
    "devDependencies": [
      "nodemon"
    ],
    "serviceDependencies": [
      "auth-service",
      "task-service"
    ],
    "envVars": [
      "PORT",
      "MONGO_URL",
      "SEKRET_KEY",
      "SERVER_URL",
      "AUTH_SERVICE_URL",
      "TASK_SERVICE_URL"
    ],
    "requiredFiles": [
      "package.json",
      "Server.js",
      "DbConnection.js",
      ".env.example",
      "controllers/authController.js",
      "models/dashboard.model.js",
      "services/dashboard.service.js",
      "controllers/dashboard.controller.js",
      "routes/dashboard.routes.js"
    ]
  }
}