@echo off
title AI Website Builder - Launcher
color 0A

echo.
echo  ============================================
echo    AI Website Builder - Auto Launcher
echo  ============================================
echo.

:: ?????? 1. Check MongoDB ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo  [1/4] Checking MongoDB...
netstat -ano | findstr ":27017" >nul 2>&1
if %errorlevel% == 0 (
    echo  [OK] MongoDB already running on port 27017
) else (
    echo  [..] Starting MongoDB...
    start "" "C:\Program Files\MongoDB\Server\7.0\bin\mongod.exe" --dbpath "C:\data\db" --port 27017 >nul 2>&1
    if %errorlevel% neq 0 (
        start "" "C:\Program Files\MongoDB\Server\6.0\bin\mongod.exe" --dbpath "C:\data\db" --port 27017 >nul 2>&1
    )
    timeout /t 3 /nobreak >nul
    netstat -ano | findstr ":27017" >nul 2>&1
    if %errorlevel% == 0 (
        echo  [OK] MongoDB started
    ) else (
        echo  [!!] MongoDB could not start - make sure MongoDB is installed
        echo      Install from: https://www.mongodb.com/try/download/community
    )
)

:: ?????? 2. Check Ollama ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo  [2/4] Checking Ollama...
netstat -ano | findstr ":11434" >nul 2>&1
if %errorlevel% == 0 (
    echo  [OK] Ollama already running on port 11434
) else (
    echo  [..] Starting Ollama...
    start "" /b ollama serve >nul 2>&1
    timeout /t 3 /nobreak >nul
    netstat -ano | findstr ":11434" >nul 2>&1
    if %errorlevel% == 0 (
        echo  [OK] Ollama started
    ) else (
        echo  [!!] Ollama not found - install from https://ollama.com
    )
)

:: ?????? 3. Start Express Backend ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo  [3/4] Starting Express Backend (port 5000)...
netstat -ano | findstr ":5000" >nul 2>&1
if %errorlevel% == 0 (
    echo  [OK] Backend already running on port 5000
) else (
    start "AI Builder - Backend" cmd /k "cd /d "%~dp0server" && echo Starting Express + MongoDB server... && node index.js"
    timeout /t 3 /nobreak >nul
    echo  [OK] Backend started
)

:: ?????? 4. Start Next.js Frontend ???????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo  [4/4] Starting Next.js Frontend...
netstat -ano | findstr ":3000" >nul 2>&1
if %errorlevel% == 0 (
    echo  [OK] Frontend already running - opening browser...
    start "" "http://localhost:3000"
) else (
    start "AI Builder - Frontend" cmd /k "cd /d "%~dp0" && echo Starting Next.js... && npm run dev"
    echo  [..] Waiting for Next.js to be ready...
    timeout /t 10 /nobreak >nul
    start "" "http://localhost:3000"
    echo  [OK] Frontend started
)

:: ?????? Done ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo.
echo  ============================================
echo    All services started!
echo  ============================================
echo.
echo    Frontend  : http://localhost:3000
echo    Backend   : http://localhost:5000
echo    Ollama    : http://localhost:11434
echo    MongoDB   : mongodb://localhost:27017
echo.
echo    Model     : deepseek-v3.1:671b-cloud (generation) + qwen2.5-coder:7b (fix/test)
echo.
echo  Press any key to exit this window...
echo  (The service windows will keep running)
echo.
pause >nul




