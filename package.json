{
  "name": "agentforge-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AgentForge Studio — agentic SRS generator (Next.js + FastAPI + LangGraph + Ollama + MongoDB)",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:shared": "npm run build --workspace @agentforge/shared",
    "build:web": "npm run build --workspace apps/web",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api --host 0.0.0.0 --port 8000",
    "lint:web": "npm run lint --workspace apps/web"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
