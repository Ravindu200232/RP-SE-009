# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_web_builder?retryWrites=true&w=majority
MONGODB_URI_TEMPLATE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/{{DB_NAME}}?retryWrites=true&w=majority
DNS_SERVERS=auto
MONGODB_COLLECTION_LIMIT=500
MONGODB_COLLECTION_RESERVE=40

# Ollama local models: Gemma-only mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_CODE_MODEL=gemma4:12b
OLLAMA_THINK=true
OLLAMA_CONTEXT_PROFILE=large
OLLAMA_NUM_CTX=131072
OLLAMA_DETECTION_CTX=32768
OLLAMA_PLAN_SMALL_CTX=32768
OLLAMA_PLAN_LARGE_CTX=32768
OLLAMA_PLAN_THINK=true
OLLAMA_CODE_CTX=32768
OLLAMA_NUM_BATCH=1024

# Build speed and quality controls
# Full-app mode: plan/build every route the SRS requires.
BUILD_CONCURRENCY=2
PAGEWISE_BATCH=8
PAGE_BATCH_SIZE=2
API_BATCH_SIZE=4
MAX_TSC_REPAIR_PASSES=4
TSC_REPAIR_FILES_PER_PASS=16
QUALITY_REPAIR_ROUNDS=3
QUALITY_REPAIR_FILES=8
MAX_FILE_ATTEMPTS=2
MAX_PLAN_PAGES=60
MAX_BUILD_PAGES=60
MAX_BUILD_STEPS=160

# Prompt/context controls
SRS_DIGEST_CHAR_CAP=70000
SRS_DIGEST_APPSPEC_CAP=45000
SRS_DIGEST_REFERENCE_CAP=18000
SRS_DIGEST_COVERAGE_CAP=70000
SRS_DIGEST_MASTER_CAP=42000
SRS_DIGEST_DATATYPES_CAP=80000
SRS_DIGEST_BACKEND_CAP=70000
SRS_DIGEST_UIDESIGN_CAP=28000
SRS_DIGEST_PAGES_CAP=60000
SRS_DIGEST_PAGEWISE_CAP=30000
SRS_DIGEST_COMPONENTS_CAP=22000
DETECTION_PROMPT_CHAR_CAP=16000
DETECTION_LLM_SKIP_CHAR_THRESHOLD=50000
FAST_REFERENCE_CHAR_THRESHOLD=20000

# Workspace
WORKSPACE_DIR=./workspace
