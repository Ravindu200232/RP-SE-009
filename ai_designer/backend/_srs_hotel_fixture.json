{
  "srs_document": {
    "document_title": "Software Requirements Specification",
    "project_name": "GrandVista Hotel Management Platform",
    "version": "1.0.0",
    "document_language": "English",
    "system_category": "Hotel Management Web Application",
    "prepared_for": "Full App Build Requirement",
    "app_summary": {
      "app_name": "GrandVista Hotel Management Platform",
      "short_description": "A complete hotel management platform with public landing website, room booking portal, hotel admin dashboard, POS system, housekeeping, inventory, staff management, billing, reports, and customer portal.",
      "business_goal": "To manage hotel operations digitally from room reservations to billing, restaurant POS, housekeeping, inventory, and customer communication.",
      "target_users": ["Hotel guests", "Reception staff", "Hotel managers", "Restaurant cashiers", "Housekeeping staff", "Inventory managers", "Accountants", "System administrators"]
    },
    "roles": [
      {"role_key": "super_admin", "role_name": "Super Admin", "description": "Full system owner with access to all hotels, branches, settings, users, reports, and audit logs."},
      {"role_key": "admin", "role_name": "Hotel Admin", "description": "Manages hotel setup, users, rooms, services, pricing, and system configuration."},
      {"role_key": "manager", "role_name": "Hotel Manager", "description": "Manages daily hotel operations, reservations, staff, reports, and approvals."},
      {"role_key": "receptionist", "role_name": "Receptionist", "description": "Handles room bookings, check-in, check-out, guest records, invoices, and payments."},
      {"role_key": "cashier", "role_name": "Cashier / POS Operator", "description": "Handles restaurant POS orders, payments, receipts, and shift cash reports."},
      {"role_key": "housekeeping", "role_name": "Housekeeping Staff", "description": "Views and updates room cleaning tasks, room status, and housekeeping reports."},
      {"role_key": "inventory_manager", "role_name": "Inventory Manager", "description": "Manages stock, suppliers, purchases, stock movements, and low-stock alerts."},
      {"role_key": "accountant", "role_name": "Accountant", "description": "Manages invoices, payments, refunds, expenses, revenue reports, and financial summaries."},
      {"role_key": "customer", "role_name": "Registered Customer", "description": "Can book rooms, view booking history, make payments, download invoices, and manage profile."},
      {"role_key": "guest", "role_name": "Public Guest", "description": "Can browse public pages, search rooms, submit contact forms, and create booking requests."}
    ],
    "main_modules": ["Public Website", "Authentication", "Customer Portal", "Admin Dashboard", "Room Management", "Reservation Management", "Check-in and Check-out", "Guest Management", "Billing and Invoicing", "Restaurant POS", "Housekeeping Management", "Inventory Management", "Supplier Management", "Staff Management", "Reports and Analytics", "Notifications", "Settings", "Audit Logs"],
    "database_design": {
      "tables": [
        {"table_name": "users", "description": "Stores login accounts for staff and customers.",
         "fields": [{"name":"id","type":"uuid","primary_key":true,"nullable":false},{"name":"full_name","type":"string","nullable":false},{"name":"email","type":"string","unique":true,"nullable":false},{"name":"phone","type":"string","nullable":true},{"name":"password_hash","type":"string","nullable":false},{"name":"role_id","type":"foreign_key","references":"roles.id","nullable":false},{"name":"status","type":"enum","values":["active","inactive","blocked"],"default":"active"},{"name":"last_login_at","type":"datetime","nullable":true},{"name":"created_at","type":"datetime","nullable":false},{"name":"updated_at","type":"datetime","nullable":false}]},
        {"table_name": "roles", "description": "Stores user roles.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"role_key","type":"string","unique":true},{"name":"role_name","type":"string"},{"name":"description","type":"text","nullable":true}]},
        {"table_name": "permissions", "description": "Stores system permissions.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"permission_key","type":"string","unique":true},{"name":"module","type":"string"},{"name":"action","type":"enum","values":["view","create","edit","delete","approve","export"]}]},
        {"table_name": "role_permissions", "description": "Many-to-many relationship between roles and permissions.",
         "fields": [{"name":"role_id","type":"foreign_key","references":"roles.id"},{"name":"permission_id","type":"foreign_key","references":"permissions.id"}]},
        {"table_name": "hotels", "description": "Stores hotel business information.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"hotel_name","type":"string","nullable":false},{"name":"description","type":"text","nullable":true},{"name":"address","type":"text","nullable":false},{"name":"city","type":"string"},{"name":"country","type":"string"},{"name":"phone","type":"string"},{"name":"email","type":"string"},{"name":"logo_url","type":"string","nullable":true},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "room_types", "description": "Stores room categories such as Deluxe, Suite, Standard, and Family Room.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"hotel_id","type":"foreign_key","references":"hotels.id"},{"name":"type_name","type":"string","nullable":false},{"name":"description","type":"text","nullable":true},{"name":"base_price_per_night","type":"decimal","nullable":false},{"name":"max_adults","type":"integer"},{"name":"max_children","type":"integer"},{"name":"amenities","type":"json","nullable":true},{"name":"image_urls","type":"json","nullable":true}]},
        {"table_name": "rooms", "description": "Stores individual hotel rooms.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"hotel_id","type":"foreign_key","references":"hotels.id"},{"name":"room_type_id","type":"foreign_key","references":"room_types.id"},{"name":"room_number","type":"string","unique":true},{"name":"floor_number","type":"integer"},{"name":"status","type":"enum","values":["available","occupied","reserved","cleaning","maintenance","inactive"],"default":"available"},{"name":"notes","type":"text","nullable":true}]},
        {"table_name": "guests", "description": "Stores guest profile information.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"full_name","type":"string"},{"name":"email","type":"string","nullable":true},{"name":"phone","type":"string","nullable":true},{"name":"nationality","type":"string","nullable":true},{"name":"id_type","type":"enum","values":["passport","nic","driving_license","other"],"nullable":true},{"name":"id_number","type":"string","nullable":true},{"name":"address","type":"text","nullable":true}]},
        {"table_name": "reservations", "description": "Stores room booking records.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"reservation_code","type":"string","unique":true},{"name":"guest_id","type":"foreign_key","references":"guests.id"},{"name":"room_type_id","type":"foreign_key","references":"room_types.id"},{"name":"room_id","type":"foreign_key","references":"rooms.id","nullable":true},{"name":"check_in_date","type":"date"},{"name":"check_out_date","type":"date"},{"name":"adults","type":"integer"},{"name":"children","type":"integer"},{"name":"booking_source","type":"enum","values":["website","walk_in","phone","agent","admin"]},{"name":"status","type":"enum","values":["pending","confirmed","checked_in","checked_out","cancelled","no_show"]},{"name":"total_amount","type":"decimal"},{"name":"paid_amount","type":"decimal","default":0},{"name":"special_requests","type":"text","nullable":true}]},
        {"table_name": "payments", "description": "Stores payment transactions.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"reservation_id","type":"foreign_key","references":"reservations.id","nullable":true},{"name":"invoice_id","type":"foreign_key","references":"invoices.id","nullable":true},{"name":"payment_method","type":"enum","values":["cash","card","bank_transfer","online_gateway"]},{"name":"amount","type":"decimal"},{"name":"payment_status","type":"enum","values":["pending","paid","failed","refunded"]},{"name":"transaction_reference","type":"string","nullable":true},{"name":"paid_at","type":"datetime","nullable":true}]},
        {"table_name": "invoices", "description": "Stores invoices for reservations, POS orders, and services.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"invoice_number","type":"string","unique":true},{"name":"guest_id","type":"foreign_key","references":"guests.id","nullable":true},{"name":"reservation_id","type":"foreign_key","references":"reservations.id","nullable":true},{"name":"subtotal","type":"decimal"},{"name":"tax_amount","type":"decimal"},{"name":"discount_amount","type":"decimal"},{"name":"grand_total","type":"decimal"},{"name":"invoice_status","type":"enum","values":["draft","issued","paid","cancelled","refunded"]},{"name":"created_by","type":"foreign_key","references":"users.id"}]},
        {"table_name": "pos_orders", "description": "Stores restaurant, cafe, minibar, and service POS orders.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"order_number","type":"string","unique":true},{"name":"guest_id","type":"foreign_key","references":"guests.id","nullable":true},{"name":"reservation_id","type":"foreign_key","references":"reservations.id","nullable":true},{"name":"order_type","type":"enum","values":["restaurant","room_service","takeaway","minibar"]},{"name":"order_status","type":"enum","values":["open","preparing","served","paid","cancelled"]},{"name":"total_amount","type":"decimal"},{"name":"created_by","type":"foreign_key","references":"users.id"}]},
        {"table_name": "pos_order_items", "description": "Stores items inside a POS order.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"pos_order_id","type":"foreign_key","references":"pos_orders.id"},{"name":"menu_item_id","type":"foreign_key","references":"menu_items.id"},{"name":"quantity","type":"integer"},{"name":"unit_price","type":"decimal"},{"name":"discount","type":"decimal"},{"name":"line_total","type":"decimal"}]},
        {"table_name": "menu_items", "description": "Stores restaurant menu items.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"item_name","type":"string"},{"name":"category","type":"string"},{"name":"price","type":"decimal"},{"name":"is_available","type":"boolean","default":true},{"name":"image_url","type":"string","nullable":true}]},
        {"table_name": "housekeeping_tasks", "description": "Stores room cleaning and housekeeping tasks.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"room_id","type":"foreign_key","references":"rooms.id"},{"name":"assigned_to","type":"foreign_key","references":"users.id"},{"name":"task_type","type":"enum","values":["cleaning","laundry","inspection","deep_cleaning"]},{"name":"status","type":"enum","values":["pending","in_progress","completed","cancelled"]},{"name":"priority","type":"enum","values":["low","medium","high"]},{"name":"due_at","type":"datetime"},{"name":"completed_at","type":"datetime","nullable":true}]},
        {"table_name": "inventory_items", "description": "Stores hotel stock items such as food, linen, cleaning items, and room supplies.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"item_name","type":"string"},{"name":"category","type":"enum","values":["food","beverage","linen","cleaning","maintenance","office","other"]},{"name":"unit","type":"string"},{"name":"current_stock","type":"decimal"},{"name":"minimum_stock_level","type":"decimal"},{"name":"cost_price","type":"decimal"},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "suppliers", "description": "Stores supplier details.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"supplier_name","type":"string"},{"name":"contact_person","type":"string","nullable":true},{"name":"phone","type":"string"},{"name":"email","type":"string","nullable":true},{"name":"address","type":"text","nullable":true}]},
        {"table_name": "stock_movements", "description": "Stores inventory stock in/out adjustments.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"inventory_item_id","type":"foreign_key","references":"inventory_items.id"},{"name":"movement_type","type":"enum","values":["stock_in","stock_out","adjustment","wastage"]},{"name":"quantity","type":"decimal"},{"name":"reason","type":"text","nullable":true},{"name":"created_by","type":"foreign_key","references":"users.id"},{"name":"created_at","type":"datetime"}]},
        {"table_name": "staff_profiles", "description": "Stores staff employee details.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id"},{"name":"employee_code","type":"string","unique":true},{"name":"department","type":"enum","values":["front_office","housekeeping","restaurant","kitchen","inventory","finance","management","maintenance"]},{"name":"job_title","type":"string"},{"name":"salary","type":"decimal","nullable":true},{"name":"joined_date","type":"date"}]},
        {"table_name": "audit_logs", "description": "Stores important system actions for security tracking.",
         "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"action","type":"string"},{"name":"module","type":"string"},{"name":"record_id","type":"string","nullable":true},{"name":"old_values","type":"json","nullable":true},{"name":"new_values","type":"json","nullable":true},{"name":"ip_address","type":"string","nullable":true},{"name":"created_at","type":"datetime"}]}
      ],
      "relationships": [
        {"from": "users.role_id", "to": "roles.id", "type": "many_to_one", "description": "Each user belongs to one role."},
        {"from": "roles.id", "to": "permissions.id", "type": "many_to_many", "via": "role_permissions", "description": "Each role can have many permissions."},
        {"from": "hotels.id", "to": "room_types.hotel_id", "type": "one_to_many", "description": "One hotel has many room types."},
        {"from": "room_types.id", "to": "rooms.room_type_id", "type": "one_to_many", "description": "One room type has many rooms."},
        {"from": "guests.id", "to": "reservations.guest_id", "type": "one_to_many", "description": "One guest can have many reservations."},
        {"from": "reservations.id", "to": "payments.reservation_id", "type": "one_to_many", "description": "One reservation can have many payments."},
        {"from": "reservations.id", "to": "invoices.reservation_id", "type": "one_to_many", "description": "One reservation can generate invoices."},
        {"from": "pos_orders.id", "to": "pos_order_items.pos_order_id", "type": "one_to_many", "description": "One POS order has many order items."},
        {"from": "rooms.id", "to": "housekeeping_tasks.room_id", "type": "one_to_many", "description": "One room can have many housekeeping tasks."},
        {"from": "inventory_items.id", "to": "stock_movements.inventory_item_id", "type": "one_to_many", "description": "One inventory item has many stock movements."}
      ]
    },
    "public_landing_website": {
      "pages": [
        {"page_name": "Home Page", "route": "/", "login_required": false, "sections": ["Hero section"]},
        {"page_name": "Rooms Page", "route": "/rooms", "login_required": false, "sections": ["Room listing"]},
        {"page_name": "Room Details Page", "route": "/rooms/:roomTypeId", "login_required": false, "sections": ["Room gallery"]},
        {"page_name": "Facilities Page", "route": "/facilities", "login_required": false, "sections": ["Restaurant"]},
        {"page_name": "Gallery Page", "route": "/gallery", "login_required": false, "sections": ["Hotel images"]},
        {"page_name": "Offers Page", "route": "/offers", "login_required": false, "sections": ["Seasonal offers"]},
        {"page_name": "About Page", "route": "/about", "login_required": false, "sections": ["Hotel story"]},
        {"page_name": "Contact Page", "route": "/contact", "login_required": false, "sections": ["Contact form"]}
      ]
    },
    "application_pages": [
      {"page_name": "Login", "route": "/login", "page_type": "auth", "login_required": false, "functions": ["Login with email and password"]},
      {"page_name": "Register", "route": "/register", "page_type": "auth", "login_required": false, "functions": ["Customer account registration"]},
      {"page_name": "Customer Dashboard", "route": "/customer/dashboard", "page_type": "portal", "login_required": true, "allowed_roles": ["customer"], "functions": ["View upcoming bookings", "View booking history", "Download invoices", "Update profile", "Cancel booking request"]},
      {"page_name": "Admin Dashboard", "route": "/admin/dashboard", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager"], "functions": ["View occupancy summary", "View revenue summary", "View today check-ins", "View today check-outs", "View low stock alerts", "View pending tasks"]},
      {"page_name": "Room Management", "route": "/admin/rooms", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager"], "functions": ["Create room type", "Create room", "Edit room", "Change room status", "Upload room images", "Manage room pricing"]},
      {"page_name": "Reservation Management", "route": "/admin/reservations", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "receptionist"], "functions": ["Create reservation", "Search reservations", "Confirm reservation", "Assign room", "Cancel reservation", "View reservation details"]},
      {"page_name": "Check-in / Check-out", "route": "/admin/front-desk", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "receptionist"], "functions": ["Guest check-in", "Guest check-out", "Verify guest ID", "Collect payment", "Generate invoice", "Print receipt"]},
      {"page_name": "POS System", "route": "/pos", "page_type": "pos", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "cashier"], "functions": ["Create restaurant order", "Add menu items", "Apply discount", "Send order to kitchen", "Accept cash/card payment", "Print POS receipt", "Add order to room bill"]},
      {"page_name": "Housekeeping Board", "route": "/admin/housekeeping", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "housekeeping"], "functions": ["View assigned rooms", "Update cleaning status", "Report room issue", "Complete housekeeping task", "View priority tasks"]},
      {"page_name": "Inventory Management", "route": "/admin/inventory", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "inventory_manager"], "functions": ["Create inventory item", "Update stock", "Record stock in", "Record stock out", "View low-stock alerts", "Manage suppliers"]},
      {"page_name": "Billing and Finance", "route": "/admin/billing", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "accountant"], "functions": ["View invoices", "Create invoice", "Record payment", "Process refund", "Export financial report", "View tax summary"]},
      {"page_name": "Staff Management", "route": "/admin/staff", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager"], "functions": ["Create staff user", "Assign role", "Update staff profile", "Deactivate staff account", "View staff attendance summary"]},
      {"page_name": "Reports", "route": "/admin/reports", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin", "manager", "accountant"], "functions": ["Occupancy report", "Revenue report", "Reservation report", "POS sales report", "Inventory report", "Export PDF", "Export Excel"]},
      {"page_name": "Settings", "route": "/admin/settings", "page_type": "dashboard", "login_required": true, "allowed_roles": ["super_admin", "admin"], "functions": ["Hotel profile settings", "Tax settings", "Payment settings", "Booking policy settings", "Email template settings", "Role permission settings"]}
    ],
    "role_access_matrix": [
      {"role": "guest", "allowed_pages": ["Home Page"], "allowed_functions": ["Browse website", "Search rooms", "Submit contact form", "Create booking request"], "restricted_functions": ["Access dashboard", "View reports", "Manage rooms", "Access POS"]},
      {"role": "customer", "allowed_pages": ["Customer Dashboard"], "allowed_functions": ["Create booking", "View own bookings", "Cancel own booking request", "Make online payment", "Download own invoice"], "restricted_functions": ["Manage other guests", "Access admin dashboard", "Access POS", "View hotel financial reports"]},
      {"role": "receptionist", "allowed_pages": ["Reservation Management"], "allowed_functions": ["Create reservation", "Assign room", "Check-in guest", "Check-out guest", "Create guest invoice", "Record front-desk payment"], "restricted_functions": ["Delete rooms", "Change system settings", "View full profit reports", "Manage role permissions"]},
      {"role": "cashier", "allowed_pages": ["POS System"], "allowed_functions": ["Create POS order", "Accept POS payment", "Print receipt", "Close cashier shift"], "restricted_functions": ["Manage hotel rooms", "Access staff management", "Change menu pricing without approval"]},
      {"role": "housekeeping", "allowed_pages": ["Housekeeping Board"], "allowed_functions": ["View assigned tasks", "Update task status", "Report maintenance issue", "Mark room cleaned"], "restricted_functions": ["View guest payment details", "Change room price", "Access reports"]},
      {"role": "inventory_manager", "allowed_pages": ["Inventory Management"], "allowed_functions": ["Create inventory item", "Update stock", "Manage suppliers", "View low-stock alerts", "Export inventory report"], "restricted_functions": ["Access guest invoices", "Process room check-in", "Change role permissions"]},
      {"role": "accountant", "allowed_pages": ["Billing and Finance"], "allowed_functions": ["View invoices", "Record payments", "Generate revenue reports", "Process refunds", "Export financial reports"], "restricted_functions": ["Change room status", "Perform housekeeping tasks", "Manage system permissions"]},
      {"role": "manager", "allowed_pages": ["Admin Dashboard"], "allowed_functions": ["View operational reports", "Approve discounts", "Manage daily operations", "Monitor staff tasks", "Manage reservations"], "restricted_functions": ["Delete system audit logs", "Change super admin account", "Modify core system configuration"]},
      {"role": "admin", "allowed_pages": ["All Admin Pages"], "allowed_functions": ["Manage hotel setup", "Manage users", "Manage roles", "Manage rooms", "Manage reservations", "Manage POS", "Manage inventory", "View reports", "Change settings"], "restricted_functions": ["Access super admin only global controls"]},
      {"role": "super_admin", "allowed_pages": ["All Pages"], "allowed_functions": ["Full system access", "Manage all hotels", "Manage all users", "Manage permissions", "View audit logs", "Export all data", "System configuration"], "restricted_functions": []}
    ],
    "functional_requirements": [
      {"id": "FR-001", "module": "Public Website", "requirement": "The system shall display a public hotel website with home, rooms, facilities, gallery, offers, about, and contact pages.", "priority": "high"},
      {"id": "FR-002", "module": "Room Search", "requirement": "The system shall allow public users to search available rooms.", "priority": "high"}
    ]
  }
}
