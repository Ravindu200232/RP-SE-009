    "api_requirements": {
      "auth_apis": ["POST /api/auth/login", "POST /api/auth/register", "POST /api/auth/logout", "GET /api/auth/me"],
      "member_apis": ["GET /api/members", "POST /api/members", "GET /api/members/{id}", "PUT /api/members/{id}", "PATCH /api/members/{id}/status"],
      "subscription_apis": ["GET /api/membership-plans", "POST /api/membership-plans", "GET /api/subscriptions", "POST /api/subscriptions", "PATCH /api/subscriptions/{id}/renew"],
      "attendance_apis": ["POST /api/attendance/check-in", "POST /api/attendance/check-out", "GET /api/attendance"],
      "class_apis": ["GET /api/classes", "POST /api/classes", "POST /api/classes/{id}/book", "GET /api/class-types"],
      "trainer_apis": ["GET /api/trainers", "POST /api/trainers", "POST /api/trainer-sessions", "POST /api/workout-plans", "POST /api/diet-plans", "POST /api/fitness-assessments"],
      "pos_apis": ["GET /api/products", "POST /api/products", "POST /api/pos/sales", "GET /api/pos/sales"],
      "inventory_apis": ["GET /api/inventory/stocks", "POST /api/inventory/adjust", "GET /api/inventory/low-stock"],
      "billing_apis": ["GET /api/invoices", "POST /api/payments", "POST /api/refunds"],
      "report_apis": ["GET /api/reports/memberships", "GET /api/reports/attendance", "GET /api/reports/revenue", "GET /api/reports/pos-sales", "GET /api/reports/export"]
    },
    "reporting_requirements": [
      { "report_name": "Membership Report", "filters": ["date range", "branch", "plan", "subscription status"], "exports": ["PDF", "Excel"] },
      { "report_name": "Attendance Report", "filters": ["date range", "branch", "member"], "exports": ["PDF", "Excel"] },
      { "report_name": "Revenue Report", "filters": ["date range", "branch", "payment method"], "exports": ["PDF", "Excel"] },
      { "report_name": "POS Sales Report", "filters": ["date range", "branch", "product category"], "exports": ["PDF", "Excel"] }
    ],
    "notification_requirements": [
      { "event": "Membership Created", "recipients": ["member", "receptionist"], "channels": ["email", "dashboard"] },
      { "event": "Membership Expiring Soon", "recipients": ["member", "receptionist", "manager"], "channels": ["email", "dashboard"] },
      { "event": "Payment Successful", "recipients": ["member", "accountant"], "channels": ["email", "dashboard"] },
      { "event": "Class Booking Confirmed", "recipients": ["member", "fitness_instructor"], "channels": ["email", "dashboard"] },
      { "event": "Trainer Session Confirmed", "recipients": ["member", "trainer"], "channels": ["email", "dashboard"] },
      { "event": "Low Stock Alert", "recipients": ["inventory_manager", "manager"], "channels": ["dashboard"] }
    ],
    "security_requirements": [
      "Use role-based access control for all protected pages and API endpoints.",
      "Store passwords using strong hashing.",
      "Validate all user input on frontend and backend.",
      "Log important user actions in audit logs.",
      "Restrict financial reports to manager, accountant, admin, and super admin roles.",
      "Members must only access their own membership, attendance, invoices, workout plans, diet plans, and progress records."
    ],
    "functional_requirements": [
      { "id": "FR-001", "module": "Public Website", "requirement": "Display public gym website with home, membership plans, classes, trainers, facilities, shop, about, and contact pages.", "priority": "high" },
      { "id": "FR-002", "module": "Member Management", "requirement": "Create, update, suspend, reactivate, and view member profiles.", "priority": "high" },
      { "id": "FR-003", "module": "Subscriptions", "requirement": "Create, renew, cancel, suspend, and track member subscriptions.", "priority": "high" },
      { "id": "FR-004", "module": "Attendance", "requirement": "Member check-in and check-out using manual search or QR code.", "priority": "high" },
      { "id": "FR-005", "module": "Class Booking", "requirement": "Members book available fitness classes subject to capacity and membership access rules.", "priority": "high" },
      { "id": "FR-006", "module": "POS", "requirement": "Cashiers sell products, supplements, memberships, classes, and trainer sessions using POS.", "priority": "high" },
      { "id": "FR-007", "module": "Reports", "requirement": "Generate membership, attendance, revenue, class booking, trainer performance, POS sales, inventory, and member progress reports.", "priority": "high" }
    ],
    "validation_rules": [
      { "field": "email", "rule": "Must be valid email format and unique." },
      { "field": "password", "rule": "Minimum 8 characters." },
      { "field": "class_booking", "rule": "Cannot be created if class capacity is full." },
      { "field": "member_check_in", "rule": "Cannot allow check-in if membership is expired or suspended." }
    ],
    "non_functional_requirements": [
      { "id": "NFR-001", "category": "Performance", "requirement": "Member search, QR check-in, and POS product search should respond within 1 second." },
      { "id": "NFR-002", "category": "Security", "requirement": "All protected API endpoints must validate authentication and role permissions." }
    ]
  }
