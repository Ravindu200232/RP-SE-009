    "business_workflows": [
      { "workflow_name": "Member Registration and Subscription Workflow", "steps": ["Guest visits public website", "Guest views membership plans", "Receptionist creates member profile", "Receptionist selects membership plan", "Member makes payment", "System activates subscription", "System generates invoice"] },
