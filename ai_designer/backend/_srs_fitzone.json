{
  "srs_document": {
    "document_title": "Software Requirements Specification",
    "project_name": "FitZone Gym and Fitness Center Management Platform",
    "version": "1.0.0",
    "document_language": "English",
    "system_category": "Gym Management, Membership, Class Booking, Trainer, POS and Admin Dashboard Web Application",
    "prepared_for": "Full App Build Requirement",
    "app_summary": {
      "app_name": "FitZone Gym Management Platform",
      "short_description": "A complete fitness center management platform with public landing website, membership registration, member portal, trainer dashboard, admin dashboard, class booking, personal training, attendance tracking, workout plans, diet plans, POS billing, product sales, inventory, payments, reports, and notifications.",
      "business_goal": "To digitally manage gym operations including memberships, trainers, members, class schedules, personal training sessions, attendance, payments, subscriptions, product sales, inventory, and business reports.",
      "target_users": [
        "Public visitors",
        "Gym members",
        "Personal trainers",
        "Fitness instructors",
        "Reception staff",
        "Cashiers",
        "Inventory managers",
        "Accountants",
        "Gym managers",
        "System administrators"
      ]
    },
    "app_type": {
      "primary_type": "Gym and Fitness Center Management System",
      "supported_types": [
        "Public Landing Website",
        "SPA Web Application",
        "PWA Mobile-Friendly Web App",
        "Member Portal",
        "Trainer Dashboard",
        "Admin Dashboard",
        "POS System",
        "Membership Management System",
        "Class Booking System",
        "Subscription Billing System"
      ],
      "frontend_type": "Responsive SPA with optional PWA support",
      "backend_type": "REST API or GraphQL API",
      "database_type": "Relational database recommended",
      "example_stack": {
        "frontend": "Next.js / React",
        "backend": "Node.js / Laravel / NestJS",
        "database": "PostgreSQL / MySQL",
        "authentication": "JWT / Session Auth",
        "file_storage": "Cloud storage or local server storage",
        "realtime": "WebSocket optional for live class capacity, notifications, and trainer booking updates"
      }
    },
    "authentication_requirement": {
      "login_required": true,
      "public_landing_pages_required": true,
      "guest_membership_inquiry_without_login": true,
      "guest_class_view_without_login": true,
      "member_account_required": true,
      "trainer_dashboard_login_required": true,
      "admin_dashboard_login_required": true,
      "pos_login_required": true,
      "multi_role_access_required": true,
      "password_reset_required": true,
      "email_verification_required": false,
      "two_factor_authentication_optional": true
    },
    "roles": [
      { "role_key": "super_admin", "role_name": "Super Admin", "description": "Full system owner with access to all branches, users, memberships, trainers, billing, inventory, reports, settings, and audit logs." },
      { "role_key": "admin", "role_name": "Gym Admin", "description": "Manages gym setup, users, membership plans, classes, trainers, pricing, packages, and system configuration." },
      { "role_key": "manager", "role_name": "Gym Manager", "description": "Manages daily gym operations, staff, memberships, classes, trainer schedules, approvals, and reports." },
      { "role_key": "receptionist", "role_name": "Receptionist", "description": "Handles member registration, check-ins, membership renewals, class booking support, and front-desk payments." },
      { "role_key": "cashier", "role_name": "Cashier / POS Operator", "description": "Handles POS sales, product billing, membership payments, receipts, refunds, and daily cash closing." },
      { "role_key": "trainer", "role_name": "Personal Trainer", "description": "Manages assigned members, workout plans, diet plans, personal training sessions, attendance, progress notes, and fitness assessments." },
      { "role_key": "fitness_instructor", "role_name": "Fitness Class Instructor", "description": "Manages group classes, class attendance, class capacity, and participant notes." },
      { "role_key": "inventory_manager", "role_name": "Inventory Manager", "description": "Manages gym product stock, supplements, accessories, suppliers, purchases, stock movements, and low-stock alerts." },
      { "role_key": "accountant", "role_name": "Accountant", "description": "Manages invoices, payments, refunds, subscription revenue, expenses, tax summaries, and financial reports." },
      { "role_key": "member", "role_name": "Gym Member", "description": "Can view membership status, book classes, book trainer sessions, view workout plans, view diet plans, make payments, and track progress." },
      { "role_key": "guest", "role_name": "Public Guest", "description": "Can browse public pages, view packages, view classes, submit membership inquiries, and contact the gym." }
    ],
    "main_modules": [
      "Public Website", "Authentication", "Member Portal", "Trainer Dashboard", "Admin Dashboard",
      "Branch Management", "Membership Plan Management", "Member Management", "Membership Subscription Management",
      "Class Schedule Management", "Class Booking Management", "Personal Training Management",
      "Workout Plan Management", "Diet Plan Management", "Attendance and Check-in Management",
      "Fitness Assessment Management", "Progress Tracking", "POS Billing", "Product and Supplement Sales",
      "Inventory Management", "Supplier Management", "Payment Management", "Invoice and Receipt Management",
      "Refund Management", "Staff Management", "Reports and Analytics", "Notifications", "Settings", "Audit Logs"
    ],
    "database_design": {
      "tables": [
        { "table_name": "users", "description": "Stores login accounts for members, trainers, staff, and admins." },
        { "table_name": "roles", "description": "Stores user roles." },
        { "table_name": "permissions", "description": "Stores system permissions." },
        { "table_name": "role_permissions", "description": "Many-to-many relationship between roles and permissions." },
        { "table_name": "branches", "description": "Stores gym branch details." },
        { "table_name": "membership_plans", "description": "Stores membership packages such as Basic, Premium, Student, Family, and Annual." },
        { "table_name": "members", "description": "Stores gym member profile information." },
        { "table_name": "member_subscriptions", "description": "Stores member active and historical subscriptions." },
        { "table_name": "trainers", "description": "Stores trainer and instructor profile information." },
        { "table_name": "class_types", "description": "Stores fitness class types such as Yoga, Zumba, HIIT, CrossFit, Cardio, and Strength Training." },
        { "table_name": "fitness_classes", "description": "Stores scheduled group fitness classes." },
        { "table_name": "class_bookings", "description": "Stores member bookings for fitness classes." },
        { "table_name": "trainer_sessions", "description": "Stores personal training session bookings." },
        { "table_name": "attendance_logs", "description": "Stores gym member check-in and check-out records." },
        { "table_name": "fitness_assessments", "description": "Stores member body measurements and fitness assessment records." },
        { "table_name": "workout_plans", "description": "Stores workout plans assigned to members." },
        { "table_name": "diet_plans", "description": "Stores diet and nutrition plans assigned to members." },
        { "table_name": "product_categories", "description": "Stores POS product categories." },
        { "table_name": "products", "description": "Stores gym POS products and supplements." },
        { "table_name": "product_stocks", "description": "Stores product stock by branch." },
        { "table_name": "stock_movements", "description": "Stores product stock movement records." },
        { "table_name": "pos_sales", "description": "Stores POS sales for products, supplements, memberships, and services." },
        { "table_name": "pos_sale_items", "description": "Stores individual items inside a POS sale." },
        { "table_name": "payments", "description": "Stores payments for subscriptions, POS sales, class bookings, and trainer sessions." },
        { "table_name": "suppliers", "description": "Stores product and supplement supplier details." },
        { "table_name": "staff_profiles", "description": "Stores staff employee details." },
        { "table_name": "audit_logs", "description": "Stores important system actions for security tracking." }
      ]
    },
