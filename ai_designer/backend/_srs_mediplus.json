{
  "srs_document": {
    "project_name": "MediPlus Pharmacy POS, Inventory and Online Ordering Platform",
    "app_summary": {"app_name": "MediPlus Pharmacy Management Platform"},
    "roles": [
      {"role_key": "super_admin", "role_name": "Super Admin"},
      {"role_key": "admin", "role_name": "System Admin"},
      {"role_key": "branch_manager", "role_name": "Branch Manager"},
      {"role_key": "pharmacist", "role_name": "Pharmacist"},
      {"role_key": "cashier", "role_name": "Cashier / POS Operator"},
      {"role_key": "inventory_manager", "role_name": "Inventory Manager"},
      {"role_key": "purchase_officer", "role_name": "Purchase Officer"},
      {"role_key": "delivery_staff", "role_name": "Delivery Staff"},
      {"role_key": "accountant", "role_name": "Accountant"},
      {"role_key": "customer", "role_name": "Registered Customer"},
      {"role_key": "guest", "role_name": "Public Guest"}
    ],
    "database_design": {
      "tables": [
        {"table_name": "users", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"full_name","type":"string"},{"name":"email","type":"string","unique":true},{"name":"role_id","type":"foreign_key","references":"roles.id"},{"name":"branch_id","type":"foreign_key","references":"branches.id","nullable":true},{"name":"status","type":"enum","values":["active","inactive","blocked"]}]},
        {"table_name": "roles", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"role_name","type":"string"}]},
        {"table_name": "permissions", "fields": [{"name":"id","type":"uuid","primary_key":true}]},
        {"table_name": "role_permissions", "fields": [{"name":"role_id","type":"foreign_key","references":"roles.id"},{"name":"permission_id","type":"foreign_key","references":"permissions.id"}]},
        {"table_name": "branches", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"branch_name","type":"string","nullable":false},{"name":"branch_code","type":"string","unique":true},{"name":"manager_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "customers", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"customer_code","type":"string","unique":true},{"name":"full_name","type":"string","nullable":false},{"name":"allergy_notes","type":"text","nullable":true},{"name":"customer_type","type":"enum","values":["regular","vip","clinic","wholesale"]}]},
        {"table_name": "medicine_categories", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"parent_category_id","type":"foreign_key","references":"medicine_categories.id","nullable":true},{"name":"category_name","type":"string","nullable":false},{"name":"slug","type":"string","unique":true},{"name":"requires_prescription_default","type":"boolean"},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "manufacturers", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"manufacturer_name","type":"string","nullable":false},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "medicines", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"medicine_code","type":"string","unique":true},{"name":"barcode","type":"string","unique":true,"nullable":true},{"name":"medicine_name","type":"string","nullable":false},{"name":"category_id","type":"foreign_key","references":"medicine_categories.id"},{"name":"manufacturer_id","type":"foreign_key","references":"manufacturers.id","nullable":true},{"name":"dosage_form","type":"enum","values":["tablet","capsule","syrup","injection","cream","drops","inhaler","powder","device","other"]},{"name":"unit","type":"enum","values":["pcs","strip","box","bottle","tube","vial","pack","ml","g"]},{"name":"cost_price","type":"decimal","nullable":false},{"name":"selling_price","type":"decimal","nullable":false},{"name":"reorder_level","type":"decimal"},{"name":"requires_prescription","type":"boolean"},{"name":"is_online_visible","type":"boolean"},{"name":"status","type":"enum","values":["active","inactive","discontinued"]}]},
        {"table_name": "medicine_batches", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"branch_id","type":"foreign_key","references":"branches.id"},{"name":"batch_number","type":"string","nullable":false},{"name":"expiry_date","type":"date","nullable":false},{"name":"current_quantity","type":"decimal"},{"name":"available_quantity","type":"decimal"},{"name":"batch_status","type":"enum","values":["active","expired","blocked","sold_out"]},{"name":"created_at","type":"datetime"}]},
        {"table_name": "stock_movements", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"batch_id","type":"foreign_key","references":"medicine_batches.id","nullable":true},{"name":"branch_id","type":"foreign_key","references":"branches.id"},{"name":"movement_type","type":"enum","values":["stock_in","stock_out","pos_sale","online_sale","return","adjustment","transfer_in","transfer_out","expired","wastage"]},{"name":"quantity","type":"decimal"},{"name":"created_by","type":"foreign_key","references":"users.id"},{"name":"created_at","type":"datetime"}]},
        {"table_name": "prescriptions", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"prescription_code","type":"string","unique":true},{"name":"customer_id","type":"foreign_key","references":"customers.id","nullable":true},{"name":"doctor_name","type":"string","nullable":true},{"name":"file_urls","type":"json","nullable":false},{"name":"reviewed_by","type":"foreign_key","references":"users.id","nullable":true},{"name":"review_status","type":"enum","values":["pending","under_review","approved","rejected","clarification_required"]},{"name":"created_at","type":"datetime"}]},
        {"table_name": "prescription_items", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"prescription_id","type":"foreign_key","references":"prescriptions.id"},{"name":"medicine_id","type":"foreign_key","references":"medicines.id","nullable":true},{"name":"quantity","type":"decimal"},{"name":"availability_status","type":"enum","values":["available","partially_available","unavailable","substitution_suggested"]},{"name":"substitute_medicine_id","type":"foreign_key","references":"medicines.id","nullable":true},{"name":"line_total","type":"decimal"}]},
        {"table_name": "pos_sales", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"invoice_number","type":"string","unique":true},{"name":"branch_id","type":"foreign_key","references":"branches.id"},{"name":"customer_id","type":"foreign_key","references":"customers.id","nullable":true},{"name":"prescription_id","type":"foreign_key","references":"prescriptions.id","nullable":true},{"name":"grand_total","type":"decimal"},{"name":"payment_status","type":"enum","values":["unpaid","partial","paid","refunded"]},{"name":"sale_status","type":"enum","values":["draft","completed","cancelled","returned"]},{"name":"created_by","type":"foreign_key","references":"users.id"},{"name":"created_at","type":"datetime"}]},
        {"table_name": "pos_sale_items", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"pos_sale_id","type":"foreign_key","references":"pos_sales.id"},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"batch_id","type":"foreign_key","references":"medicine_batches.id","nullable":true},{"name":"quantity","type":"decimal"},{"name":"unit_price","type":"decimal"},{"name":"line_total","type":"decimal"}]},
        {"table_name": "online_orders", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"order_number","type":"string","unique":true},{"name":"customer_id","type":"foreign_key","references":"customers.id","nullable":true},{"name":"prescription_id","type":"foreign_key","references":"prescriptions.id","nullable":true},{"name":"delivery_address","type":"text","nullable":false},{"name":"grand_total","type":"decimal"},{"name":"order_status","type":"enum","values":["pending","prescription_review","confirmed","packing","ready_for_delivery","out_for_delivery","delivered","cancelled","rejected"]},{"name":"payment_status","type":"enum","values":["unpaid","paid","failed","refunded"]},{"name":"assigned_delivery_staff_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"created_at","type":"datetime"}]},
        {"table_name": "online_order_items", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"online_order_id","type":"foreign_key","references":"online_orders.id"},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"batch_id","type":"foreign_key","references":"medicine_batches.id","nullable":true},{"name":"quantity","type":"decimal"},{"name":"unit_price","type":"decimal"},{"name":"line_total","type":"decimal"}]},
        {"table_name": "suppliers", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"supplier_code","type":"string","unique":true},{"name":"supplier_name","type":"string","nullable":false},{"name":"status","type":"enum","values":["active","inactive"]}]},
        {"table_name": "purchase_orders", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"po_number","type":"string","unique":true},{"name":"supplier_id","type":"foreign_key","references":"suppliers.id"},{"name":"branch_id","type":"foreign_key","references":"branches.id"},{"name":"grand_total","type":"decimal"},{"name":"status","type":"enum","values":["draft","pending_approval","approved","ordered","partially_received","received","cancelled"]},{"name":"created_by","type":"foreign_key","references":"users.id"},{"name":"approved_by","type":"foreign_key","references":"users.id","nullable":true}]},
        {"table_name": "purchase_order_items", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"purchase_order_id","type":"foreign_key","references":"purchase_orders.id"},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"ordered_quantity","type":"decimal"},{"name":"unit_cost","type":"decimal"},{"name":"line_total","type":"decimal"}]},
        {"table_name": "goods_received_notes", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"grn_number","type":"string","unique":true},{"name":"purchase_order_id","type":"foreign_key","references":"purchase_orders.id","nullable":true},{"name":"supplier_id","type":"foreign_key","references":"suppliers.id"},{"name":"branch_id","type":"foreign_key","references":"branches.id"},{"name":"total_amount","type":"decimal"},{"name":"status","type":"enum","values":["draft","posted","cancelled"]},{"name":"created_by","type":"foreign_key","references":"users.id"}]},
        {"table_name": "grn_items", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"grn_id","type":"foreign_key","references":"goods_received_notes.id"},{"name":"medicine_id","type":"foreign_key","references":"medicines.id"},{"name":"batch_number","type":"string","nullable":false},{"name":"expiry_date","type":"date","nullable":false},{"name":"received_quantity","type":"decimal"},{"name":"unit_cost","type":"decimal"},{"name":"line_total","type":"decimal"}]},
        {"table_name": "returns", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"return_number","type":"string","unique":true},{"name":"pos_sale_id","type":"foreign_key","references":"pos_sales.id","nullable":true},{"name":"online_order_id","type":"foreign_key","references":"online_orders.id","nullable":true},{"name":"customer_id","type":"foreign_key","references":"customers.id","nullable":true},{"name":"refund_amount","type":"decimal"},{"name":"status","type":"enum","values":["requested","approved","rejected","refunded"]},{"name":"approved_by","type":"foreign_key","references":"users.id","nullable":true},{"name":"created_at","type":"datetime"}]},
        {"table_name": "payments", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"pos_sale_id","type":"foreign_key","references":"pos_sales.id","nullable":true},{"name":"online_order_id","type":"foreign_key","references":"online_orders.id","nullable":true},{"name":"payment_method","type":"enum","values":["cash","card","bank_transfer","online_gateway","wallet","credit"]},{"name":"amount","type":"decimal"},{"name":"payment_status","type":"enum","values":["pending","paid","failed","refunded"]},{"name":"paid_at","type":"datetime","nullable":true}]},
        {"table_name": "staff_profiles", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id"},{"name":"employee_code","type":"string","unique":true},{"name":"branch_id","type":"foreign_key","references":"branches.id","nullable":true},{"name":"department","type":"enum","values":["pharmacy","cashier","inventory","purchase","delivery","finance","management","admin"]},{"name":"job_title","type":"string"},{"name":"joined_date","type":"date"}]},
        {"table_name": "audit_logs", "fields": [{"name":"id","type":"uuid","primary_key":true},{"name":"user_id","type":"foreign_key","references":"users.id","nullable":true},{"name":"action","type":"string"},{"name":"module","type":"string"},{"name":"created_at","type":"datetime"}]}
      ],
      "relationships": [
        {"from": "users.role_id", "to": "roles.id", "type": "many_to_one"},
        {"from": "roles.id", "to": "permissions.id", "type": "many_to_many", "via": "role_permissions"},
        {"from": "branches.manager_id", "to": "users.id", "type": "many_to_one"},
        {"from": "customers.user_id", "to": "users.id", "type": "one_to_one_optional"},
        {"from": "medicine_categories.parent_category_id", "to": "medicine_categories.id", "type": "self_reference"},
        {"from": "medicines.category_id", "to": "medicine_categories.id", "type": "many_to_one"},
        {"from": "medicines.id", "to": "medicine_batches.medicine_id", "type": "one_to_many"},
        {"from": "prescriptions.id", "to": "prescription_items.prescription_id", "type": "one_to_many"},
        {"from": "pos_sales.id", "to": "pos_sale_items.pos_sale_id", "type": "one_to_many"},
        {"from": "online_orders.id", "to": "online_order_items.online_order_id", "type": "one_to_many"},
        {"from": "suppliers.id", "to": "purchase_orders.supplier_id", "type": "one_to_many"},
        {"from": "goods_received_notes.id", "to": "grn_items.grn_id", "type": "one_to_many"}
      ]
    },
    "public_landing_website": {"pages": [
      {"page_name": "Home Page", "route": "/"}, {"page_name": "Medicines Page", "route": "/medicines"},
      {"page_name": "Prescription Upload Page", "route": "/prescription-upload"}, {"page_name": "Health Products Page", "route": "/health-products"},
      {"page_name": "About Page", "route": "/about"}, {"page_name": "Contact Page", "route": "/contact"},
      {"page_name": "Cart Page", "route": "/cart"}, {"page_name": "Checkout Page", "route": "/checkout"}
    ]},
    "application_pages": [
      {"page_name": "Customer Dashboard", "route": "/customer/dashboard", "allowed_roles": ["customer"], "functions": ["View recent orders","View prescription review status","Download invoices"]},
      {"page_name": "Admin Dashboard", "route": "/admin/dashboard", "allowed_roles": ["super_admin","admin","branch_manager"], "functions": ["View today POS sales","View prescription review queue","View low-stock alerts","View expiry alerts"]},
      {"page_name": "POS System", "route": "/pos", "allowed_roles": ["super_admin","admin","branch_manager","pharmacist","cashier"], "functions": ["Scan barcode","Search medicine","Select batch using FEFO expiry logic","Validate prescription required products","Accept cash payment","Print receipt"]},
      {"page_name": "Prescription Review", "route": "/admin/prescriptions", "allowed_roles": ["super_admin","admin","branch_manager","pharmacist"], "functions": ["View uploaded prescriptions","Add prescription items","Approve prescription","Reject prescription","Suggest substitute medicine"]},
      {"page_name": "Medicine Management", "route": "/admin/medicines", "allowed_roles": ["super_admin","admin","branch_manager","inventory_manager","pharmacist"], "functions": ["Create medicine","Set prescription required status","Set selling price","Generate barcode"]},
      {"page_name": "Inventory and Batch Management", "route": "/admin/inventory", "allowed_roles": ["super_admin","admin","branch_manager","inventory_manager","pharmacist"], "functions": ["View batch stock","Adjust stock","View near-expiry medicines","Block expired batches","Transfer stock between branches"]},
      {"page_name": "Supplier Management", "route": "/admin/suppliers", "allowed_roles": ["super_admin","admin","branch_manager","purchase_officer"], "functions": ["Create supplier"]},
      {"page_name": "Purchase Orders", "route": "/admin/purchase-orders", "allowed_roles": ["super_admin","admin","branch_manager","purchase_officer"], "functions": ["Create purchase order","Approve purchase order"]},
      {"page_name": "Goods Received Notes", "route": "/admin/grn", "allowed_roles": ["super_admin","admin","branch_manager","purchase_officer","inventory_manager"], "functions": ["Create GRN","Record batch number","Record expiry date"]},
      {"page_name": "Online Orders", "route": "/admin/online-orders", "allowed_roles": ["super_admin","admin","branch_manager","pharmacist","cashier","delivery_staff"], "functions": ["View online orders","Confirm order","Send prescription order to pharmacist review","Assign delivery staff"]},
      {"page_name": "Billing and Finance", "route": "/admin/billing", "allowed_roles": ["super_admin","admin","branch_manager","accountant"], "functions": ["View invoices","Process refund","Export financial report"]},
      {"page_name": "Returns and Refunds", "route": "/admin/returns", "allowed_roles": ["super_admin","admin","branch_manager","pharmacist","cashier","accountant"], "functions": ["Create return request","Approve return","Process refund"]},
      {"page_name": "Staff Management", "route": "/admin/staff", "allowed_roles": ["super_admin","admin","branch_manager"], "functions": ["Create staff user"]},
      {"page_name": "Reports", "route": "/admin/reports", "allowed_roles": ["super_admin","admin","branch_manager","accountant","inventory_manager"], "functions": ["Sales report","Prescription report","Expiry report"]},
      {"page_name": "Settings", "route": "/admin/settings", "allowed_roles": ["super_admin","admin"], "functions": ["Business profile settings","Prescription policy settings"]}
    ],
    "role_access_matrix": [
      {"role": "pharmacist", "allowed_functions": ["Review prescriptions","Approve prescriptions","Reject prescriptions","Suggest substitutes","Validate prescription medicines"], "restricted_functions": ["Delete audit logs"]},
      {"role": "cashier", "allowed_functions": ["Create POS sale","Scan medicines","Apply allowed discount","Accept payments","Print receipts"], "restricted_functions": ["Approve prescription","Delete medicines"]},
      {"role": "inventory_manager", "allowed_functions": ["Create medicine","Update stock","Manage batches","Receive stock","Block expired batches"], "restricted_functions": ["Approve prescriptions unless pharmacist role is also assigned"]},
      {"role": "purchase_officer", "allowed_functions": ["Create supplier","Create purchase order","Receive goods"], "restricted_functions": ["Access POS","Approve prescriptions"]},
      {"role": "delivery_staff", "allowed_functions": ["View assigned orders","Update delivery status","Mark order delivered"], "restricted_functions": ["Access POS"]},
      {"role": "accountant", "allowed_functions": ["View invoices","Record payments","Process refunds","Generate tax reports"], "restricted_functions": ["Approve prescriptions"]},
      {"role": "branch_manager", "allowed_functions": ["Manage daily operations","Approve discounts","Approve returns","Monitor prescription queue"], "restricted_functions": ["Delete audit logs"]},
      {"role": "admin", "allowed_functions": ["Manage branches","Manage users","Manage medicines","Manage prescriptions"], "restricted_functions": []},
      {"role": "super_admin", "allowed_functions": ["Full system access"], "restricted_functions": []}
    ],
    "functional_requirements": [
      {"id": "FR-001", "module": "Public Website", "requirement": "Public pharmacy website with home, medicines, prescription upload, health products, about, contact, cart, checkout."}
    ]
  }
}
