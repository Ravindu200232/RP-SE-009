# Copy to .env and fill in. .env is gitignored.
# Use a STABLE Google AI Studio API key (starts with "AIza"), not a short-lived
# OAuth access token (starts with "AQ." / "ya29." — those expire in ~1 hour).
GEMINI_API_KEY=AIza-your-key-here
GEMINI_PROJECT=your-project-number
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
