{
  "service_name": "Item-Service",
  "port": 5002,
  "database_name": "neighborly_item_db",
  "files_to_create": [
    {
      "file_path": "src/models/Item.js",
      "file_type": "Model",
      "purpose": "Define the database schema for items with strict types, references, and validation rules.",
      "imports_needed": [
        "mongoose"
      ],
      "data_structure_or_endpoint_spec": {
        "schema_fields": {
          "title": {
            "type": "String",
            "required": true
          },
          "description": {
            "type": "String"
          },
          "owner": {
            "type": "ObjectId",
            "ref": "User",
            "required": true
          },
          "rentalType": {
            "type": "String",
            "enum": [
              "rent",
              "share"
            ],
            "required": true
          }
        }
      },
      "logic_steps_for_coder": [
        "Step 1: Import mongoose.",
        "Step 2: Define the Item schema with required fields and validation rules.",
        "Step 3: Export the Item model."
      ],
      "exports": "Item"
    },
    {
      "file_path": "src/controllers/ItemController.js",
      "file_type": "Controller",
      "purpose": "Handle business logic for item-related operations.",
      "imports_needed": [
        "../models/Item",
        "../utils/auth"
      ],
      "data_structure_or_endpoint_spec": {
        "endpoint_methods": [
          {
            "method_name": "createItem",
            "description": "Create a new item"
          },
          {
            "method_name": "getItemById",
            "description": "Retrieve an item by ID"
          },
          {
            "method_name": "listItems",
            "description": "List all items"
          }
        ]
      },
      "logic_steps_for_coder": [
        "Step 1: Import required models and utility functions.",
        "Step 2: Implement createItem to validate input, hash password if necessary, save item to database, and return response.",
        "Step 3: Implement getItemById to find item by ID in the database and return response.",
        "Step 4: Implement listItems to retrieve all items from the database and return response."
      ],
      "exports": "createItem, getItemById, listItems"
    },
    {
      "file_path": "src/routes/ItemRoutes.js",
      "file_type": "Route",
      "purpose": "Define HTTP routes for item-related operations.",
      "imports_needed": [
        "express",
        "./ItemController"
      ],
      "data_structure_or_endpoint_spec": {
        "route_methods": [
          {
            "method_name": "POST /api/items",
            "description": "Create a new item"
          },
          {
            "method_name": "GET /api/items/:id",
            "description": "Retrieve an item by ID"
          },
          {
            "method_name": "GET /api/items",
            "description": "List all items"
          }
        ]
      },
      "logic_steps_for_coder": [
        "Step 1: Import required modules and controller functions.",
        "Step 2: Define routes for creating, retrieving, and listing items.",
        "Step 3: Apply authentication middleware to protected routes if necessary."
      ],
      "exports": "itemRoutes"
    },
    {
      "file_path": "src/config/index.js",
      "file_type": "Config",
      "purpose": "Configure environment variables and other settings.",
