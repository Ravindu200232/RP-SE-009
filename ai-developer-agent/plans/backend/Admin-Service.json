{
  "service_name": "Admin-Service",
  "port": 5005,
  "database_name": "neighborly_admin_db",
  "files_to_create": [
    {
      "file_path": "src/models/Report.js",
      "file_type": "Model",
      "purpose": "Define the database schema for reports with necessary fields and references.",
      "imports_needed": [
        "mongoose"
      ],
      "data_structure_or_endpoint_spec": {
        "schema_fields": {
          "description": {
            "type": "String",
            "required": true
          },
          "user": {
            "type": "ObjectId",
            "ref": "User",
            "required": true
          }
        }
      },
      "logic_steps_for_coder": [
        "Step 1: Import mongoose.",
        "Step 2: Define the Report schema with 'description' and 'user' fields, both marked as required.",
        "Step 3: Export the Report model."
      ],
      "exports": "Report"
    },
    {
      "file_path": "src/controllers/ReportController.js",
      "file_type": "Controller",
      "purpose": "Handle business logic for reports such as viewing and flagging profiles.",
      "imports_needed": [
        "../models/Report",
        "../models/User"
      ],
      "data_structure_or_endpoint_spec": {
        "endpoint_methods": {
          "viewReports": {
            "description": "Retrieve all reports from the database."
          },
          "flagProfile": {
            "description": "Flag a user's profile for review.",
            "parameters": [
              {
                "name": "userId",
                "type": "String",
                "required": true
              }
            ]
          },
          "handleRefundDispute": {
            "description": "Handle refund disputes.",
            "parameters": [
              {
                "name": "disputeId",
                "type": "String",
                "required": true
              }
            ]
          }
        }
      },
      "logic_steps_for_coder": [
        "Step 1: Import the Report and User models.",
        "Step 2: Implement 'viewReports' to fetch all reports from the database.",
        "Step 3: Implement 'flagProfile' to update a user's profile status in the database.",
        "Step 4: Implement 'handleRefundDispute' to manage refund disputes."
      ],
      "exports": "viewReports, flagProfile, handleRefundDispute"
    },
    {
      "file_path": "src/routes/ReportRoutes.js",
      "file_type": "Route",
      "purpose": "Define API endpoints for reports.",
      "imports_needed": [
        "express",
        "../controllers/ReportController"
      ],
      "data_structure_or_endpoint_spec": {
        "route_methods": [
          {
            "method": "GET",
            "endpoint": "/api/reports",
            "handler": "viewReports"
          },
          {
            "method": "POST",
            "endpoint": "/api/admin/flag-profile",
            "handler": "flagProfile"
          },
          {
            "method": "POST",
            "endpoint": "/api/admin/handle-dispute",
            "handler": "handleRefundDispute"
          }
        ]
      },
      "logic_steps_for_coder": [
        "Step 1: Import express and the ReportController.",
        "Step 2: Define routes for viewing reports, flagging profiles, and handling refund disputes.",
        "Step 3: Export the router."
      ],
      "exports": "router"
    }
  ]
}