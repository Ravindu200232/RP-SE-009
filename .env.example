# ─────────────────────────────────────────────────────────────
# AgentForge Studio — environment configuration
# Copy this file to `.env` and adjust values as needed.
# ─────────────────────────────────────────────────────────────

# ── Ollama (local LLM) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Local model. Use whatever `ollama list` shows ("gEmma" not "gAmma").
OLLAMA_PRIMARY_MODEL=nemotron-3-super:cloud
OLLAMA_FALLBACK_MODEL=nemotron-3-super:cloud
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_NUM_CTX=8192

# If Ollama is unreachable the backend uses a deterministic, schema-valid
# offline generator so the app still runs (great for demos & CI).
# Set to "false" to hard-fail instead of falling back.
LLM_ALLOW_OFFLINE_FALLBACK=true

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/agentforge
MONGODB_DB=agentforge
# If Mongo is unreachable the backend falls back to an in-memory store.
MONGODB_ALLOW_MEMORY_FALLBACK=true

# ── Storage ──────────────────────────────────────────────────
STORAGE_DIR=./generated
SAMPLES_DIR=./samples

# ── API server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Diagram rendering ────────────────────────────────────────
# Path to mermaid-cli (`npm i -g @mermaid-js/mermaid-cli`). If missing,
# diagram sources (.mmd) are still produced and the SVG render is skipped.
MERMAID_CLI=mmdc

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
